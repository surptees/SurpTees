{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "surptees-checkout-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "surptees.com/api/*",
      "zone_name": "surptees.com"
    },
    {
      "pattern": "www.surptees.com/api/*",
      "zone_name": "surptees.com"
    }
  ]
}
